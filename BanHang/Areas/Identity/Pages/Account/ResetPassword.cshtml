@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "ĐẶT LẠI MẬT KHẨU";
}

<link rel="stylesheet" href="~/css/login_logout.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="login-wrapper">
    <div class="login-box">
        <div class="login-header text-center">
            <h2 class="fw-bold">@ViewData["Title"]</h2>
            <p class="text-muted">Nhập mã OTP gửi về Gmail để khôi phục mật khẩu</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small" role="alert"></div>

            <div class="mb-3">
                <input asp-for="Input.Email" class="form-control custom-input" placeholder="Địa chỉ Email" readonly="@(!string.IsNullOrEmpty(Model.Input.Email))" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <input asp-for="Input.Code" class="form-control custom-input" placeholder="Mã OTP gồm 6 chữ số" required />
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <input asp-for="Input.Password" class="form-control custom-input" type="password" placeholder="Mật khẩu mới" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control custom-input" type="password" placeholder="Xác nhận mật khẩu mới" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-submit-dark w-100 mb-3">XÁC NHẬN ĐỔI MẬT KHẨU</button>
        </form>

        <div class="login-footer mt-4 text-center">
            <p class="mb-1 text-muted">Quay lại <a href="/Identity/Account/Login" class="fw-bold text-dark">Đăng nhập</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
