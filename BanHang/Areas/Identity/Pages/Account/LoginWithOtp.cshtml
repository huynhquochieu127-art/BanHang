@page
@model LoginWithOtpModel
@{
    ViewData["Title"] = "ĐĂNG NHẬP BẰNG OTP";
}

<link rel="stylesheet" href="~/css/login_logout.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="login-wrapper">
    <div class="login-box">
        <div class="login-header text-center">
            <h2 class="fw-bold">@ViewData["Title"]</h2>
            <p class="text-muted">Đăng nhập nhanh bằng mã OTP gửi về địa chỉ Gmail của bạn</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center small mb-3 py-2" style="border-radius: 6px; border: 1px solid #c3e6cb; background-color: #d4edda; color: #155724; font-weight: 500;">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small text-center" role="alert"></div>

        @* Bước 1: Nhập Email *@
        <form method="post" asp-page-handler="SendOtp" class="mb-3">
            <div class="mb-3">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 custom-input-icon" style="border: 1.5px solid #ddd; border-right: none; border-radius: 4px 0 0 4px;"><i class="fas fa-envelope text-muted"></i></span>
                    <input asp-for="Input.Email" class="form-control custom-input border-start-0" placeholder="Địa chỉ Email của bạn" style="border-radius: 0 4px 4px 0;" readonly="@Model.OtpSent" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            @if (!Model.OtpSent)
            {
                <button type="submit" class="btn-submit-dark w-100"><i class="fas fa-paper-plane"></i> GỬI MÃ OTP QUA GMAIL</button>
            }
            else
            {
                <div class="text-end small mt-1">
                    <button type="submit" class="btn btn-link p-0 text-decoration-none text-danger fw-bold" style="font-size: 13px;"><i class="fas fa-sync-alt"></i> Gửi lại mã OTP khác</button>
                </div>
            }
        </form>

        @* Bước 2: Nhập OTP khi đã gửi thành công *@
        @if (Model.OtpSent)
        {
            <form method="post" asp-page-handler="VerifyOtp">
                @* Giữ lại Email để post *@
                <input type="hidden" asp-for="Input.Email" />

                <div class="mb-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 custom-input-icon" style="border: 1.5px solid #ddd; border-right: none; border-radius: 4px 0 0 4px;"><i class="fas fa-key text-muted"></i></span>
                        <input asp-for="Input.Otp" class="form-control custom-input border-start-0" placeholder="Nhập mã OTP gồm 6 chữ số" style="border-radius: 0 4px 4px 0; font-weight: bold; letter-spacing: 2px; text-align: center;" required autocomplete="off" />
                    </div>
                    <span asp-validation-for="Input.Otp" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-submit-dark w-100 mb-3" style="background-color: #2ecc71; border-color: #2ecc71; color: white;"><i class="fas fa-sign-in-alt"></i> ĐĂNG NHẬP NGAY</button>
            </form>
        }

        <div class="login-footer mt-4 text-center">
            <p class="mb-1 text-muted">Quay lại <a href="/Identity/Account/Login" class="fw-bold text-dark">Đăng nhập bằng Mật khẩu</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
