@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<link rel="stylesheet" href="~/css/login_logout.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="login-wrapper">
    <div class="login-box" style="max-width: 480px; text-align: center; padding: 40px 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); background-color: #fff;">
        <div style="font-size: 64px; color: #2ecc71; margin-bottom: 20px; animation: scaleUp 0.3s ease-out;">
            <i class="fas fa-check-circle"></i>
        </div>
        <h2 class="fw-bold" style="color: #333; margin-bottom: 15px; font-size: 22px; letter-spacing: 0.5px;">ĐẶT LẠI THÀNH CÔNG</h2>
        <p class="text-muted" style="font-size: 15px; line-height: 1.6; margin-bottom: 30px; padding: 0 10px;">
            Mật khẩu của bạn đã được cập nhật thành công. Bây giờ bạn đã có thể đăng nhập bằng mật khẩu mới.
        </p>
        <div class="text-center">
            <a href="/Identity/Account/Login" class="btn-submit-dark" style="text-decoration: none; display: block; padding: 12px; background-color: #333; color: #fff; border-radius: 4px; font-weight: bold; transition: background 0.2s;">Đăng nhập ngay</a>
        </div>
    </div>
</div>

<style>
    @@keyframes scaleUp {
        0% { transform: scale(0.7); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>
