@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Xác nhận đổi mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Forgot.css" asp-append-version="true" />
}

<div class="confirmation-wrapper">
    <div class="confirmation-container" style="max-width: 500px; margin: 50px auto; padding: 30px; border: 1px solid #ddd; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); background-color: #fff; text-align: center;">
        <h2 style="color: #333; font-weight: bold; margin-bottom: 20px;">@ViewData["Title"]</h2>
        <hr style="margin-bottom: 20px;" />
        <p style="font-size: 16px; color: #555; line-height: 1.6; margin-bottom: 25px;">
            Hệ thống đã gửi một mã OTP khôi phục mật khẩu đến địa chỉ email của bạn. Vui lòng kiểm tra hộp thư đến (hoặc hộp thư rác / Spam) và làm theo hướng dẫn.
        </p>
        <div class="text-center mt-4">
            <a href="/Identity/Account/ResetPassword" class="btn-submit-dark" style="text-decoration: none; display: inline-block; padding: 12px 30px; background-color: #222; color: #fff; border-radius: 4px; font-weight: bold; transition: all 0.2s;">Đặt lại mật khẩu</a>
        </div>
    </div>
</div>